{
  "name": "mas-backend-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "system/*",
    "apps/*"
  ],
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "db:sync": "bun run db:generate && bun run db:migrate",
    "build": "bun scripts/build.ts",
    "start": "bun dist/server/main.js",
    "check": "bun run typecheck && bun run format:check && bun test",
    "dev:server": "bun scripts/server-process.ts --watch",
    "dev:web-cms": "bun run --cwd apps/web-cms dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --cwd apps/web-cms typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:integration": "bun scripts/test-integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun database/migrate.ts",
    "db:reset": "bun scripts/db-reset.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.3",
    "prettier": "^3.8.1",
    "drizzle-kit": "^0.31.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.5.0",
    "@sinclair/typebox": "^0.34.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  }
}
